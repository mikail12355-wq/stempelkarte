# ===== Dein Café =====
CAFE_NAME=Coffee Dream
CAFE_ADDRESS=Musterstraße 1, 12345 Musterstadt
CAFE_WEBSITE=https://www.deincafe.de
PRIVACY_URL=https://www.deincafe.de/datenschutz
STAMPS_REQUIRED=10
REWARD_TEXT=1 Gratis-Kaffee
REFERRAL_BONUS=1
REFERRAL_MAX_PER_CUSTOMER=10

# Farben der Karte
COLOR_BACKGROUND=#4a2c1f
COLOR_TEXT=#ffffff
COLOR_LABEL=#f3d9b1
COLOR_STAMP=#f3d9b1

# ===== Server =====
# Die endgültige Adresse, unter der der Server erreichbar ist (mit https://).
# WICHTIG: Nicht mehr ändern, nachdem Gäste Karten haben – sonst bekommen deren Karten keine Updates mehr.
BASE_URL=https://karte.deincafe.de
# PIN für dein Team (Stempel-Seite unter /team)
STAFF_PIN=4711
# Langer Zufallstext, z. B. mit: openssl rand -hex 32
SESSION_SECRET=
# Auf Railway: Ordner des Volumes
DATA_DIR=/data

# ===== Apple Wallet =====
APPLE_PASS_TYPE_ID=pass.de.deincafe.stempelkarte
APPLE_TEAM_ID=ABCDE12345
# Entweder Dateien in certs/ (signerCert.pem, signerKey.pem, wwdr.pem)
# oder als Base64 (für Railway) – erzeugen mit: bash scripts/base64-fuer-railway.sh
APPLE_SIGNER_CERT_B64=
APPLE_SIGNER_KEY_B64=
APPLE_WWDR_B64=

# ===== Google Wallet =====
GOOGLE_ISSUER_ID=
# Entweder Datei certs/google-service-account.json oder Base64
GOOGLE_SERVICE_ACCOUNT_B64=
